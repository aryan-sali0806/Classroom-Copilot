# App
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Database — localhost for local dev, db for Docker Compose
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/classroom_copilot

# Frontend URL (used after OAuth callback)
FRONTEND_URL=http://localhost:5173

# Google OAuth — create at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Gemini — get at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Poller interval in minutes
POLL_INTERVAL_MINUTES=15
